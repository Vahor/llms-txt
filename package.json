{
	"name": "@vahor/llms-txt",
	"version": "0.1.1",
	"description": "A simple script to generate llms.txt and .md files from your content.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Vahor/llms-txt.git"
	},
	"module": "index.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"main": "./dist/index.cjs",
	"private": false,
	"files": [
		"dist"
	],
	"author": {
		"email": "me@vahor.fr"
	},
	"keywords": [
		"llms.txt"
	],
	"devDependencies": {
		"@biomejs/biome": "2.4.15",
		"@changesets/changelog-github": "^0.7.0",
		"@changesets/cli": "^2.31.0",
		"@types/bun": "^1.3.14",
		"bun-plugin-dts": "^0.4.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.0.4",
		"pkg-pr-new": "^0.0.72",
		"typescript": "^6.0.3",
		"unist-util-visit": "^5.1.0"
	},
	"scripts": {
		"prepare": "husky",
		"build": "bun run build.ts",
		"format": "bunx @biomejs/biome check ./ --write",
		"typecheck": "tsc --noEmit --declaration",
		"ci:version": "bunx @changesets/cli version",
		"ci:publish": "bun run build && bunx @changesets/cli publish"
	},
	"lint-staged": {
		"*": [
			"biome check --no-errors-on-unmatched --files-ignore-unknown=true"
		]
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"remark-parse": "^11.0.0",
		"remark-stringify": "^11.0.0",
		"unified": "^11.0.5",
		"yaml": "^2.9.0"
	}
}
